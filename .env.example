# ==========================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==========================================
# NOTE: Never place real production secrets or keys in this file.
# Use Google Cloud Secret Manager or secure deployment injections for production environments.

# Application Environment ('production' or 'development')
NODE_ENV=<SET_TO_production_OR_development>

# Port number for the server to listen on (Injected automatically by Cloud Run)
PORT=3000

# Supabase Project Database URL
SUPABASE_URL=<SUPABASE_PROJECT_URL>

# Supabase Service Role / Anon API Key (Must be stored in Secret Manager in production)
SUPABASE_KEY=<SET_IN_SECRET_MANAGER>

# JWT / HMAC Authentication Secret Key (Must be at least 32 random characters in production)
AUTH_SECRET_KEY=<SET_IN_SECRET_MANAGER_MIN_32_CHARS>

# Gemini AI API Key
GEMINI_API_KEY=<SET_IN_SECRET_MANAGER>

# Public Application URL
APP_URL=<CLOUD_RUN_URL>

# Role-Based Access Control (RBAC) Default Admin/Clerk Profiles
OWNER_USER=admin
OWNER_PASS=<SET_SECURE_PASSWORD>
CLERK_USER=clerk
CLERK_PASS=<SET_SECURE_PASSWORD>

# Automated Daily Financial Report & Email Dispatch Settings
SENDER_EMAIL=<YOUR_SYSTEM_NOTIFICATIONS_EMAIL>
SENDER_PASSWORD=<GMAIL_APP_PASSWORD>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
CRON_SECRET=<SET_SECURE_CRON_SECRET>
